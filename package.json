{
  "name": "risu-workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter app dev\" \"pnpm --filter admin dev\"",
    "dev:app": "pnpm --filter app dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:server": "cd server && go run ./cmd",
    "build:app": "pnpm --filter app build",
    "build:admin": "pnpm --filter admin build",
    "migrate": "cd server && go run ./scripts/migrate"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
